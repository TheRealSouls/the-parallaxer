# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep the documented template; real .env files stay ignored above.
!.env.example

/src/generated/prisma

# Prisma generates TypeScript client sources here on every `prisma generate`.
/src/generated

# The favicon set has been copied into src/app and public; the extracted folder
# is just the unpacked zip.
/src/media/favicon_unzipped
