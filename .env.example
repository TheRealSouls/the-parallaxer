# Copy this file to .env and fill it in. .env is gitignored; never commit real values.

# --- Database ---------------------------------------------------------------
# Neon Postgres. Create a project at neon.tech, then copy the pooled connection
# string. It must end with ?sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth ------------------------------------------------------------
# Signs session cookies. Generate a fresh one, never reuse the example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# The site's own origin. In production set this to https://theparallaxer.com,
# otherwise OAuth redirects will come back to localhost.
BETTER_AUTH_URL="http://localhost:3000"

# --- Google sign-in ---------------------------------------------------------
# Optional. Leave both blank and the site runs with email and password only;
# the Google button simply does not appear.
#
# From console.cloud.google.com, APIs & Services, Credentials, "Create
# credentials", "OAuth client ID", type "Web application". Add these two
# authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://theparallaxer.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- First administrator ----------------------------------------------------
# The first account created with this email address becomes an admin and the
# founding editor. Everyone else signs up as a reader. Set this before you sign
# in for the first time; it has no effect on an account that already exists.
ADMIN_EMAIL="matas.roda@gmail.com"

# --- Newsletter ---------------------------------------------------------------
# Shared secret for POST /api/newsletter/send, which mails the weekly digest.
# Generate one the same way as BETTER_AUTH_SECRET. Without it the endpoint
# refuses to run at all, rather than sitting there unprotected.
CRON_SECRET=""
