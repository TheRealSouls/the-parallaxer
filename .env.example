# Stage 1 needs no environment variables. This file documents what Stage 2 adds.

# Neon Postgres connection string.
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth. Generate the secret with: openssl rand -base64 32
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client, created in Google Cloud Console. The consent screen needs
# working links to /privacy and /terms before it will verify.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# The first account to sign in with this address is promoted to admin.
# ADMIN_EMAIL=""
